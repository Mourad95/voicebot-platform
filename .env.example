NODE_ENV=development
PORT=3000

# Local (make dev / make seed) — adapter le mot de passe si besoin
# ===== DATABASE - MongoDB =====
MONGO_USER=voicebot
MONGO_PASSWORD=change_me_dev_password


TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=
# Mettre à true en dev pour logger le SMS sans l'envoyer
SMS_MOCK=true
RETELL_API_KEY=
TEST_PHONE=+33600000000
SECTOR=immo

# ===== Garde-fous anti-abus (appels) — valeurs par défaut si non définies =====
# Nombre max d'appels d'un même numéro sur 24h glissantes
CALL_MAX_PER_PHONE_PER_DAY=5
# Nombre max d'appels total sur 24h glissantes (plafond budget)
CALL_MAX_PER_DAY=200
# Nombre max d'appels simultanés
CALL_MAX_CONCURRENT=10