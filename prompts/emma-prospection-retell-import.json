        "instruction": {
          "type": "static_text",
          "text": "Bonjour, je m'appelle Emma, je suis une assistante vocale. Je vous appelle de la part de Flowcraft. Je ne vais pas vous vendre quelque chose, je vais juste vous montrer ce que je sais faire. Vous avez 30 secondes ?"
        }
